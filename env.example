# 🔐 ENGIE Environment Variables
# Copy this file to .env and fill in your actual values

# ========================================
# 🤖 AI Service API Keys
# ========================================

# Anthropic Claude API (Primary)
ANTHROPIC_API_KEY=sk-ant-api03-your-key-here

# OpenAI API (Fallback)
OPENAI_API_KEY=sk-your-openai-key-here

# Perplexity AI (Research)
PERPLEXITY_API_KEY=pplx-your-key-here

# Google AI API (Optional)
GOOGLE_API_KEY=your-google-ai-key-here

# ========================================
# 🍎 Apple Developer Code Signing
# ========================================

# Apple Developer Account (for notarization)
APPLE_ID=your-apple-id@example.com
APPLE_TEAM_ID=ABC123DEF4
APPLE_ID_PASSWORD=your-app-specific-password

# Code Signing Certificate Name (from: security find-identity -v -p codesigning)
CSC_NAME="Developer ID Application: Your Name (ABC123DEF4)"

# ========================================
# 🧠 Local AI Configuration
# ========================================

# Ollama Base URL (if using custom setup)
OLLAMA_BASE_URL=http://localhost:11434/api

# Local LLM Model Preference
LOCAL_LLM_MODEL=phi3:latest

# ========================================
# 🎯 TaskMaster Integration
# ========================================

# TaskMaster AI Configuration
TASKMASTER_LOG_LEVEL=info
TASKMASTER_MAX_TOKENS=4000
TASKMASTER_TEMPERATURE=0.7

# ========================================
# 🔧 Development Settings
# ========================================

# Environment
NODE_ENV=development

# Debug Logging
DEBUG=engie:*
ELECTRON_IS_DEV=1

# ========================================
# 📊 Analytics & Telemetry (Optional)
# ========================================

# Disable telemetry for privacy
DISABLE_TELEMETRY=true
ELECTRON_DISABLE_SECURITY_WARNINGS=true 