<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
  <dict>
    <!-- Basic app entitlements -->
    <key>com.apple.security.cs.allow-jit</key>
    <true/>
    <key>com.apple.security.cs.allow-unsigned-executable-memory</key>
    <true/>
    <key>com.apple.security.cs.disable-library-validation</key>
    <true/>
    
    <!-- Network access for AI services -->
    <key>com.apple.security.network.client</key>
    <true/>
    <key>com.apple.security.network.server</key>
    <true/>
    
    <!-- File system access for TaskMaster and project files -->
    <key>com.apple.security.files.user-selected.read-write</key>
    <true/>
    <key>com.apple.security.files.downloads.read-write</key>
    <true/>
    
    <!-- Camera and microphone for future AI features -->
    <key>com.apple.security.device.camera</key>
    <true/>
    <key>com.apple.security.device.microphone</key>
    <true/>
    
    <!-- Screen recording for context monitoring -->
    <key>com.apple.security.device.capture</key>
    <true/>
    
    <!-- Keychain access for secure API key storage -->
    <key>keychain-access-groups</key>
    <array>
      <string>$(AppIdentifierPrefix)com.engie.macos-app</string>
    </array>
    
    <!-- AppleScript/automation for window detection -->
    <key>com.apple.security.automation.apple-events</key>
    <true/>
    
    <!-- Process information access -->
    <key>com.apple.security.cs.debugger</key>
    <true/>
    
    <!-- Hardened runtime entitlements -->
    <key>com.apple.security.cs.allow-dyld-environment-variables</key>
    <true/>
  </dict>
</plist> 